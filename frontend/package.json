{
  "name": "architrack-frontend",
  "version": "1.0.0",
  "description": "ArchiTrack Frontend",
  "packageManager": "npm@11.6.2+sha512.ee22b335fcbc95662cdf3ab8a053daf045d9cf9c6df6040d28965abb707512b2c16fa6c5eec049d34c74f78f390cebd14f697919eadb97756564d4f9eccc4954",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:analyze": "tsc && vite build --mode production && echo 'Bundle analysis report generated at dist/stats.html'",
    "bundle:check": "node scripts/check-bundle-size.js",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --maxWorkers=50%",
    "test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npm run build-storybook --quiet && npx http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && npm run test-storybook\"",
    "storybook:coverage": "node scripts/check-storybook-coverage.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "rm -rf coverage && mkdir -p coverage/.tmp && vitest run --coverage",
    "coverage:check": "node scripts/check-coverage-gaps.cjs",
    "lint": "eslint src/**/*.{js,jsx,ts,tsx} vitest.*.ts",
    "lint:fix": "eslint src/**/*.{js,jsx,ts,tsx} vitest.*.ts --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\" \"vitest.*.ts\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\" \"vitest.*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@holiday-jp/holiday_jp": "^2.5.1",
    "@sentry/react": "^10.69.0",
    "fabric": "^7.3.1",
    "jspdf": "^4.0.0",
    "jszip": "^3.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.16.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@storybook/test-runner": "^0.24.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.4.23",
    "axe-playwright": "^2.2.2",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.4.4",
    "tailwindcss": "^4.3.3",
    "terser": "^5.49.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "tar": "^7.5.3",
    "undici": "^7.28.0"
  }
}
