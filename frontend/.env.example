# ============================================
# ArchiTrack Frontend Environment Variables
# ============================================

# --------------------------------------------
# API Configuration
# --------------------------------------------
# Backend API URL
# This is where the frontend will send API requests
#
# For local development:
#   VITE_API_URL=http://localhost:3000
#
# For production:
#   VITE_API_URL=https://your-backend.railway.app
#
# REQUIRED: No (defaults to http://localhost:3000 in code if not set)
VITE_API_URL=http://localhost:3000

# --------------------------------------------
# Application Configuration
# --------------------------------------------
# Application title (optional, for future use)
# VITE_APP_TITLE=ArchiTrack

# Application version (optional, for future use)
# VITE_APP_VERSION=1.0.0

# --------------------------------------------
# Feature Flags (optional, for future use)
# --------------------------------------------
# Enable debug mode
# VITE_DEBUG_MODE=false

# Enable analytics
# VITE_ENABLE_ANALYTICS=false

# --------------------------------------------
# Monitoring (Sentry)
# --------------------------------------------
# Sentry DSN for frontend error reporting
# The error boundaries and page-level catch handlers always call the reporting
# path; whether anything is actually transmitted depends solely on this value.
#
# When UNSET (the default, and the case for every build in this repository),
# initSentry() and captureException() return immediately and monitoring
# emission is a deliberate no-op. Nothing is sent anywhere.
#
# NOTE: this is a Vite variable, so it is inlined at BUILD time, not read at
# runtime. Setting it on an already-built container has no effect - the
# frontend image must be rebuilt with the value present (see the
# VITE_SENTRY_DSN build argument in frontend/Dockerfile).
#
# For production:
#   VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
#
# REQUIRED: No (monitoring emission is disabled when not set)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
