{
  "name": "architrack",
  "version": "1.0.0",
  "description": "ArchiTrack E2E Tests",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npx prisma generate",
    "dev:docker": "docker compose -p architrack-dev -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up",
    "dev:docker:build": "docker compose -p architrack-dev -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up --build",
    "dev:docker:down": "docker compose -p architrack-dev -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev down",
    "dev:docker:logs": "docker compose -p architrack-dev -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev logs -f",
    "test:docker": "docker compose -p architrack-test -f docker-compose.yml -f docker-compose.test.yml --env-file .env.test up -d",
    "test:docker:build": "docker compose -p architrack-test -f docker-compose.yml -f docker-compose.test.yml --env-file .env.test up -d --build",
    "test:docker:down": "docker compose -p architrack-test -f docker-compose.yml -f docker-compose.test.yml --env-file .env.test down",
    "test:docker:logs": "docker compose -p architrack-test -f docker-compose.yml -f docker-compose.test.yml --env-file .env.test logs -f",
    "test:e2e": "cross-env NODE_ENV=test DISABLE_RATE_LIMIT=true DATABASE_URL=postgresql://postgres:test@localhost:5433/architrack_test playwright test",
    "test:e2e:ui": "cross-env NODE_ENV=test DISABLE_RATE_LIMIT=true DATABASE_URL=postgresql://postgres:test@localhost:5433/architrack_test playwright test --ui",
    "test:e2e:headed": "cross-env NODE_ENV=test DISABLE_RATE_LIMIT=true DATABASE_URL=postgresql://postgres:test@localhost:5433/architrack_test playwright test --headed",
    "test:e2e:debug": "cross-env NODE_ENV=test DISABLE_RATE_LIMIT=true DATABASE_URL=postgresql://postgres:test@localhost:5433/architrack_test playwright test --debug",
    "test:e2e:report": "playwright show-report $(ls -td playwright-report/*/ | head -1)",
    "test:coverage": "npm --prefix backend run test:coverage && npm --prefix frontend run test:coverage",
    "lint": "eslint e2e/**/*.{js,ts} playwright.config.{js,ts} scripts/**/*.ts",
    "lint:fix": "eslint e2e/**/*.{js,ts} playwright.config.{js,ts} scripts/**/*.ts --fix",
    "format": "prettier --write \"e2e/**/*.{js,ts}\" \"playwright.config.{js,ts}\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"e2e/**/*.{js,ts}\" \"playwright.config.{js,ts}\" \"scripts/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "check:e2e-guards": "npx tsx scripts/check-e2e-assertion-guards.ts",
    "check:e2e-guards:verbose": "npx tsx scripts/check-e2e-assertion-guards.ts --verbose",
    "check:e2e-guards:update": "npx tsx scripts/check-e2e-assertion-guards.ts --update-baseline",
    "check:e2e-guards:selftest": "npx tsx scripts/check-e2e-assertion-guards.selftest.ts",
    "classify:e2e-guards": "npx tsx scripts/classify-e2e-assertion-guards.ts",
    "check:e2e-selfjudge": "npx tsx scripts/check-e2e-in-page-selfjudgement.ts",
    "check:e2e-selfjudge:verbose": "npx tsx scripts/check-e2e-in-page-selfjudgement.ts --verbose",
    "check:e2e-selfjudge:selftest": "npx tsx scripts/check-e2e-in-page-selfjudgement.selftest.ts",
    "check:design-refs": "npx tsx scripts/check-design-reference-format.ts",
    "check:design-refs:verbose": "npx tsx scripts/check-design-reference-format.ts --verbose",
    "check:design-refs:selftest": "npx tsx scripts/check-design-reference-format.selftest.ts",
    "check:design-code-refs": "npx tsx scripts/check-design-code-reference-format.ts",
    "check:design-code-refs:verbose": "npx tsx scripts/check-design-code-reference-format.ts --verbose",
    "check:design-code-refs:selftest": "npx tsx scripts/check-design-code-reference-format.selftest.ts",
    "check:design-path-refs": "npx tsx scripts/check-design-path-references.ts",
    "check:design-path-refs:verbose": "npx tsx scripts/check-design-path-references.ts --verbose",
    "check:design-path-refs:json": "npx tsx scripts/check-design-path-references.ts --json",
    "check:design-path-refs:update": "npx tsx scripts/check-design-path-references.ts --update-baseline",
    "check:design-path-refs:selftest": "npx tsx scripts/check-design-path-references.selftest.ts",
    "check:trace-coverage": "npx tsx scripts/check-traceability-coverage.ts",
    "check:trace-coverage:verbose": "npx tsx scripts/check-traceability-coverage.ts --verbose",
    "check:trace-coverage:json": "npx tsx scripts/check-traceability-coverage.ts --json",
    "check:trace-coverage:survey": "npx tsx scripts/check-traceability-coverage.ts --survey",
    "check:trace-coverage:selftest": "npx tsx scripts/check-traceability-coverage.selftest.ts",
    "check:steering-refs": "npx tsx scripts/check-steering-file-references.ts",
    "check:steering-refs:verbose": "npx tsx scripts/check-steering-file-references.ts --verbose",
    "check:steering-refs:selftest": "npx tsx scripts/check-steering-file-references.selftest.ts",
    "check:steering-idents": "npx tsx scripts/check-steering-identifier-references.ts",
    "check:steering-idents:verbose": "npx tsx scripts/check-steering-identifier-references.ts --verbose",
    "check:steering-idents:json": "npx tsx scripts/check-steering-identifier-references.ts --json",
    "check:steering-idents:selftest": "npx tsx scripts/check-steering-identifier-references.selftest.ts",
    "check:steering-test-tree": "npx tsx scripts/check-steering-test-tree.ts",
    "check:steering-test-tree:verbose": "npx tsx scripts/check-steering-test-tree.ts --verbose",
    "check:steering-test-tree:json": "npx tsx scripts/check-steering-test-tree.ts --json",
    "check:steering-test-tree:selftest": "npx tsx scripts/check-steering-test-tree.selftest.ts",
    "check:req-coverage": "npx tsx scripts/check-requirement-coverage.ts",
    "check:req-coverage:verbose": "npx tsx scripts/check-requirement-coverage.ts --verbose",
    "check:req-coverage:json": "npx tsx scripts/check-requirement-coverage.ts --json",
    "check:req-coverage:strict": "npx tsx scripts/check-requirement-coverage.ts --strict",
    "check:req-coverage:selftest": "npx tsx scripts/check-requirement-coverage.selftest.ts",
    "check:cf-evidence": "npx tsx scripts/check-counterfactual-evidence.ts",
    "check:cf-evidence:verbose": "npx tsx scripts/check-counterfactual-evidence.ts --verbose",
    "check:cf-evidence:json": "npx tsx scripts/check-counterfactual-evidence.ts --json",
    "check:cf-evidence:survey": "npx tsx scripts/check-counterfactual-evidence.ts --survey",
    "check:cf-evidence:list": "npx tsx scripts/check-counterfactual-evidence.ts --list",
    "check:cf-evidence:selftest": "npx tsx scripts/check-counterfactual-evidence.selftest.ts",
    "check:req-exclusions": "npx tsx scripts/check-requirement-exclusions.ts",
    "check:req-exclusions:verbose": "npx tsx scripts/check-requirement-exclusions.ts --verbose",
    "check:req-exclusions:selftest": "npx tsx scripts/check-requirement-exclusions.selftest.ts",
    "audit:security": "node scripts/security-audit.mjs",
    "audit:security:verbose": "node scripts/security-audit.mjs --verbose",
    "audit:security:warn": "node scripts/security-audit.mjs --mode=warn",
    "coverage:staged:backend": "node scripts/check-staged-coverage.cjs --project=backend",
    "coverage:staged:frontend": "node scripts/check-staged-coverage.cjs --project=frontend",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.63.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "exceljs": "^4.4.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "pdfjs-dist": "^6.2.108",
    "prettier": "^3.9.5",
    "prisma": "^7.8.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0"
  },
  "overrides": {
    "hono": "^4.12.25",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  }
}
