{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrack.invalid/schemas/requirement-exclusions.schema.json",
  "title": "E2E対象外の受入基準の定義",
  "description": "e2e/requirement-exclusions.json の形式。除外は被覆率の分母から受入基準を外すため、掲げた代替検証と分類が欠けると被覆の主張が空洞化する。必須項目と語彙をここで固定する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "description",
    "version",
    "lastUpdated",
    "exclusions",
    "categories",
    "summary"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./requirement-exclusions.schema.json",
      "description": "本スキーマへの相対参照。実在しない先を指すことを禁じるため値を固定する。"
    },
    "description": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "lastUpdated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/exclusion" }
    },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/category" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "title", "reason", "category", "alternativeVerification"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:[a-z0-9][a-z0-9-]*/)?REQ-[0-9]+[A-E]?\\.[0-9]+$",
          "description": "受入基準の識別子。機能名を冠する形（feature/REQ-N.M）と、機能名を省いた旧来の形（REQ-N.M）の双方を許す。"
        },
        "requirement": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "categories に定義済みの分類名。実在する分類であることは検査側で照合する。"
        },
        "alternativeVerification": { "$ref": "#/$defs/alternativeVerification" }
      }
    },
    "alternativeVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "tool", "description"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "threshold": { "type": "string", "minLength": 1 }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "verificationPhase"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "verificationPhase": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalExclusions", "byCategory", "note"],
      "properties": {
        "totalExclusions": { "type": "integer", "minimum": 0 },
        "byCategory": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
