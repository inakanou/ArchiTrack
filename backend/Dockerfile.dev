FROM node:22.23.4-alpine3.24@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202

WORKDIR /app

# package.json の "packageManager" で指定した npm を corepack で固定する
RUN corepack enable npm

# ヘルスチェック用にcurlをインストール
RUN apk add --no-cache curl

# package.jsonとpackage-lock.jsonをコピー
COPY package*.json ./

# エントリポイントスクリプトをコピー
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# 初回ビルド時にnode_modulesをインストール（npm ciで厳密な依存関係管理）
RUN npm ci

COPY . .

# /appディレクトリの所有権をnodeユーザー（UID 1000）に変更
# docker-compose.ymlでuser: 1000:1000として実行されるため、
# ホストマウントされたファイルの権限問題を回避
RUN chown -R node:node /app

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["npm", "run", "dev"]
