{
  "name": "architrack-backend",
  "version": "1.0.0",
  "description": "ArchiTrack Backend API",
  "packageManager": "npm@11.6.2+sha512.ee22b335fcbc95662cdf3ab8a053daf045d9cf9c6df6040d28965abb707512b2c16fa6c5eec049d34c74f78f390cebd14f697919eadb97756564d4f9eccc4954",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run prisma:generate && tsc && npm run docs:generate",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:debug": "tsx --inspect=0.0.0.0:9229 watch src/index.ts",
    "dev:node": "npm run build && node dist/src/index.js",
    "dev:js": "node --watch src/index.js",
    "check:env": "tsx src/check-env.ts",
    "validate:esm": "npm run build && node --check dist/src/index.js && find dist -name '*.js' -type f -exec node --check {} \\;",
    "test": "vitest run",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "RUN_INTEGRATION_TESTS=true vitest run src/__tests__/integration",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "rm -rf coverage && mkdir -p coverage/.tmp && vitest run --coverage",
    "test:unit:coverage": "rm -rf coverage && mkdir -p coverage/.tmp && vitest run --coverage src/__tests__/unit",
    "coverage:check": "node scripts/check-coverage-gaps.cjs",
    "test:integration:coverage": "rm -rf coverage && mkdir -p coverage/.tmp && RUN_INTEGRATION_TESTS=true vitest run --coverage src/__tests__/integration",
    "test:all": "RUN_INTEGRATION_TESTS=true vitest run",
    "test:perf": "tsx performance/health-check.perf.ts",
    "test:perf:login": "tsx performance/login.perf.ts",
    "test:perf:project": "tsx performance/project-crud.perf.ts",
    "test:perf:trading-partner": "tsx performance/trading-partner-crud.perf.ts",
    "test:perf:report": "autocannon -c 10 -d 30 http://localhost:3000/health",
    "docs:generate": "tsx src/generate-swagger.ts",
    "lint": "eslint src/**/*.{js,ts} vitest.*.ts performance/**/*.ts scripts/**/*.ts prisma/**/*.ts",
    "lint:fix": "eslint src/**/*.{js,ts} vitest.*.ts performance/**/*.ts scripts/**/*.ts prisma/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.{js,ts}\" \"vitest.*.ts\" \"performance/**/*.ts\" \"scripts/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{js,ts}\" \"vitest.*.ts\" \"performance/**/*.ts\" \"scripts/**/*.ts\" \"prisma/**/*.ts\"",
    "type-check": "npm run prisma:generate && tsc --noEmit",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "audit:production": "npm audit --omit=dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "generate:jwt-keys": "tsx scripts/generate-eddsa-keys.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/client-sesv2": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@holiday-jp/holiday_jp": "^2.5.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "@types/bull": "^4.10.4",
    "@types/handlebars": "^4.1.0",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/xlsx": "^0.0.35",
    "bloom-filters": "^3.0.4",
    "bull": "^4.16.5",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.0",
    "express-rate-limit": "^8.5.2",
    "handlebars": "^4.7.8",
    "helmet": "^8.3.0",
    "ioredis": "^5.10.1",
    "jose": "^6.1.3",
    "jspdf": "^4.1.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "otplib": "^12.0.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.10",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/autocannon": "^7.12.7",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.0.8",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.7.0",
    "husky": "^9.0.11",
    "lint-staged": "^17.0.5",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prisma": "^7.8.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "prisma/schema.prisma": [
      "prisma format"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "hono": "^4.12.25",
    "fast-xml-parser": "^5.3.6"
  }
}
